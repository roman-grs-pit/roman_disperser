# pixi environments
.pixi
.pixi-backup
#!.pixi/config.toml

# Python ignores
*.pyc
__pycache__/


# MacOS ignores
.DS_Store

# Jupyter Notebook ignores
*.ipynb_checkpoints/

# NOTE on trailing slashes below: a pattern ending in `/` matches directories
# only, so it does NOT match a symlink pointing at one. Worktrees that link
# these entries at the shared cache (`$ROMAN_DISPERSER_DATA`) instead of
# hydrating locally left them showing as untracked, one `git add -A` away from
# being committed. The vendored entries are therefore written without the slash.

# PSF cache files (large, machine-generated)
data/psf_cache

# Source catalog artifacts (large, downloaded as assets)
data/catalogs/metadata.parquet
data/catalogs/seds.zarr/

# Vendored reference data (fetched by `roman-disperser-hydrate`, versioned in
# roman_disperser_data releases; no longer tracked here). Globbed over element
# and version so the prism model and future revisions are covered too.
data/Roman_*_OpticalModel_*.yaml
data/sensitivities
data/sensitivities_prism
data/synphot
data/data-versions.lock

# Validation outputs (generated by notebooks)
data/psf_validation_results.csv
data/psf_radial_validation.pkl

# Workbench data files (large, per-study). `**` so it also covers studies with
# a nested layout, e.g. workbench/<campaign>/<wave>/data/.
workbench/**/data/

# Temporary markdown file to edit prompts
prompt.md

# Pipeline output directory
output/

# Temporary images for Claude Code screenshot sharing
output.png
