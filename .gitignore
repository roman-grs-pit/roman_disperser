# pixi environments
.pixi
.pixi-backup
#!.pixi/config.toml

# Python ignores
*.pyc
__pycache__/


# MacOS ignores
.DS_Store

# Jupyter Notebook ignores
*.ipynb_checkpoints/

# PSF cache files (large, machine-generated)
data/psf_cache/

# Source catalog artifacts (large, downloaded as assets)
data/catalogs/metadata.parquet
data/catalogs/seds.zarr/

# Vendored reference data (fetched by `roman-disperser-hydrate`, versioned in
# roman_disperser_data releases; no longer tracked here)
data/Roman_grism_OpticalModel_v0.8.yaml
data/sensitivities/
data/synphot/
data/data-versions.lock

# Validation outputs (generated by notebooks)
data/psf_validation_results.csv
data/psf_radial_validation.pkl

# Workbench data files (large, per-study). `**` so it also covers studies with
# a nested layout, e.g. workbench/<campaign>/<wave>/data/.
workbench/**/data/

# Temporary markdown file to edit prompts
prompt.md

# Pipeline output directory
output/

# Temporary images for Claude Code screenshot sharing
output.png
